{
    "expo": {
        "name": "График приступов",
        "slug": "seizure",
        "scheme": "seizure",
        "version": "0.0.1",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "splash": {
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "android": {
            "package": "com.alex8bits.seizure",
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#ffffff"
            }
        },
        "plugins": [
            "expo-router",
            "expo-secure-store",
            "expo-localization",
            [
                "./plugins/activity-alias/plugin",
                { "iconBackgroundColor": "#C62828" }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}
