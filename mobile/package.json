        "expo-secure-store": "~57.0.3",
        "expo-status-bar": "~57.0.1",
        "react": "19.2.8",
        "react-native": "0.87.1"
    },
    "devDependencies": {
        "@babel/core": "^7.25.0",
        "@eslint/eslintrc": "^3.3.7",
        "@stylistic/eslint-plugin": "^2.13.0",
        "@types/node": "^26.4.1",
        "@types/react": "~19.2.0",
        "@typescript-eslint/eslint-plugin": "^8.69.0",
        "eslint": "^9.17.0",
        "eslint-config-expo": "~57.0.0",
        "prettier": "^3.4.2",
        "typescript": "~5.6.0",
        "vitest": "^5.0.0"
