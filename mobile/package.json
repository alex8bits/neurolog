{
    "name": "seizure-mobile",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "expo-router/entry",
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "prebuild": "expo prebuild --platform android",
